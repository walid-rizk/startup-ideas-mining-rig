# ─── API Keys ────────────────────────────────────────────────────────
# Add the keys for the provider(s) you want to use.
# You only need the key(s) for the models you select in the app.
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Google Gemini (Gemini 2.5 Flash, 2.5 Pro, 3.0 Flash, 3.0 Pro, 3.1 Flash)
# Get a key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic (Claude Haiku 4.5, Sonnet 4.6, Opus 4.6, Opus 4.7, Opus 4.8, Fable 5)
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT 5.4 Mini, 5.4, 5.5)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
